{
  "name": "my-opencode-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "watch": "shadow-cljs watch opencode",
    "build": "shadow-cljs release opencode",
    "plugin:copy": "mkdir -p .opencode/plugins && cp dist/plugin.js .opencode/plugins/my-plugin.js",
    "plugin:link": "mkdir -p .opencode/plugins && ln -sf $(pwd)/dist/plugin.js .opencode/plugins/my-plugin.js",
    "create": "node scripts/create-plugin.mjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.41",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "shadow-cljs": "^3.4.11"
  }
}
